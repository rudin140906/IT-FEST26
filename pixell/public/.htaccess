# PHP Upload and Memory Limits (for Apache mod_php)
<IfModule mod_php7.c>
  php_value upload_max_filesize 32M
  php_value post_max_size 36M
  php_value memory_limit 256M
  php_value max_execution_time 300
  php_value max_input_time 300
</IfModule>
<IfModule mod_php.c>
  php_value upload_max_filesize 32M
  php_value post_max_size 36M
  php_value memory_limit 256M
  php_value max_execution_time 300
  php_value max_input_time 300
</IfModule>

# MIME Types
<IfModule mod_mime.c>
  AddType application/pdf .pdf
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
</IfModule>

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve uploaded assets directly
  RewriteRule ^api/uploads/(.*)$ uploads/$1 [L,NC]

  # Direct API mappings
  RewriteRule ^api/admin/login/?$ api/admin/login.php [L,QSA,NC]
  RewriteRule ^api/admin/logout/?$ api/admin/logout.php [L,QSA,NC]
  RewriteRule ^api/admin/check/?$ api/admin/check.php [L,QSA,NC]
  RewriteRule ^api/partners-visibility/?$ api/partners-visibility.php [L,QSA,NC]
  RewriteRule ^api/partners/?$ api/partners.php [L,QSA,NC]
  RewriteRule ^api/sponsors/?$ api/sponsors.php [L,QSA,NC]
  RewriteRule ^api/media-partners/?$ api/media-partners.php [L,QSA,NC]
  RewriteRule ^api/timeline/?$ api/timeline.php [L,QSA,NC]
  RewriteRule ^api/events/?$ api/events.php [L,QSA,NC]
  RewriteRule ^api/speakers/?$ api/speakers.php [L,QSA,NC]
  RewriteRule ^api/upload/?$ api/upload.php [L,QSA,NC]
  RewriteRule ^api/setup-db/?$ api/setup-db.php [L,QSA,NC]
  RewriteRule ^api/test-db/?$ api/test-db.php [L,QSA,NC]
  RewriteRule ^api/check/?$ api/admin/check.php [L,QSA,NC]

  # Catch-all for clean API routes (only if NOT an existing file or directory, and NOT already ending in .php)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.php$ [NC]
  RewriteRule ^api/(.+?)/?$ api/$1.php [L,QSA,NC]

  # Static HTML Page Routing Fallbacks
  RewriteRule ^admin/?$ admin/index.html [L,NC]
  RewriteRule ^admin/partners/?$ admin/partners/index.html [L,NC]
  RewriteRule ^admin/events/?$ admin/events/index.html [L,NC]
  RewriteRule ^admin/speakers/?$ admin/speakers/index.html [L,NC]
  RewriteRule ^competition/?$ competition/index.html [L,NC]
  RewriteRule ^training/?$ training/index.html [L,NC]
  RewriteRule ^seminar/?$ seminar/index.html [L,NC]
  RewriteRule ^register/?$ register/index.html [L,NC]
</IfModule>
